"Open Login Items & Extensions…" = "Abrir Itens de Início de Sessão e Extensões…";
"General" = "Geral";
"Keyboard Shortcuts" = "Atalhos de Teclado";
"Toggle Tacet" = "Alternar Tacet";
"%@ is already used by another app." = "%@ já é usado por outro app.";
"Type Shortcut" = "Digite o Atalho";
"Record Shortcut" = "Gravar Atalho";
"Clear Shortcut" = "Apagar Atalho";
"Click to record a new shortcut." = "Clique para gravar um novo atalho.";
"Show All Items" = "Mostrar Todos os Itens";
"Toggle Always Hidden" = "Alternar Sempre Ocultos";
"Use ⌘, ⌥ or ⌃ in the shortcut." = "Use ⌘, ⌥ ou ⌃ no atalho.";
"%@ is used by macOS. Choose a different shortcut." = "%@ é usado pelo macOS. Escolha outro atalho.";
"%@ is already used by another app. Choose a different shortcut." = "%@ já é usado por outro app. Escolha outro atalho.";
"Space" = "Espaço";


