/* Tacet: pt-BR. Keys are the English text in the source; see README › Localization. */

/* Onboarding */
"Welcome to Tacet" = "Boas-vindas ao Tacet";
"Tacet uses the macOS switches" = "O Tacet usa os ajustes do macOS";
"It hides apps with the “Allow in the Menu Bar” switches in System Settings › Menu Bar. macOS does the hiding, so Notification Center, Focus and the camera and microphone indicators keep working." = "Ele oculta apps com o ajuste “Permitir na Barra de Menus” em Ajustes do Sistema › Barra de Menus. Quem oculta é o macOS, então a Central de Notificações, o Foco e os indicadores de câmera e microfone continuam funcionando.";
"Hidden apps show as off in System Settings" = "Apps ocultos aparecem desativados nos Ajustes do Sistema";
"Click « in the menu bar to bring them back. If anything ever goes wrong, turn them back on in System Settings › Menu Bar." = "Clique em « na Barra de Menus para trazê-los de volta. Se algo der errado, ative-os de novo em Ajustes do Sistema › Barra de Menus.";
"Quitting turns them back on" = "Encerrar o Tacet os reativa";
"Quitting Tacet turns every app it hid back on. Quit Tacet before you delete it." = "Ao encerrar, o Tacet reativa todos os apps que ocultou. Encerre o Tacet antes de apagá-lo.";
"Tacet arranges the icons" = "O Tacet organiza os ícones";
"Hidden apps sit left of the arrow, always-hidden ones further left. Tacet keeps that order, so there’s nothing to drag." = "Os apps ocultos ficam à esquerda da seta, e os sempre ocultos mais à esquerda ainda. O Tacet mantém essa ordem, então não é preciso arrastar nada.";
"This version of macOS doesn’t offer the switches Tacet needs." = "Esta versão do macOS não oferece os ajustes de que o Tacet precisa.";
"Tacet can change the switches." = "O Tacet pode alterar os ajustes.";
"Allow Tacet to change the switches" = "Permita que o Tacet altere os ajustes";
"macOS keeps the switches and the order of the menu bar icons in two settings folders. In the next window, hold ⌘ and select “%@” and “%@” (the only ones you can click), then click Grant Access. Tacet changes only the “Allow in the Menu Bar” switches and the order of the icons." = "O macOS guarda os ajustes e a ordem dos ícones da Barra de Menus em duas pastas de ajustes. Na próxima janela, mantenha ⌘ pressionado e selecione “%@” e “%@” (as únicas que dá para clicar) e clique em Conceder Acesso. O Tacet altera apenas os ajustes de “Permitir na Barra de Menus” e a ordem dos ícones.";
"Tacet lost access to the switches. Apps it hid may still be off: grant access again and Tacet turns them back on when you quit it, or turn them on yourself in System Settings › Menu Bar." = "O Tacet perdeu o acesso aos ajustes. Os apps que ele ocultou podem continuar desativados: conceda o acesso de novo e o Tacet os reativa quando você encerrá-lo, ou ative-os você mesmo em Ajustes do Sistema › Barra de Menus.";
"Choose Apps to Hide…" = "Escolher Apps para Ocultar…";
"Grant Access…" = "Conceder Acesso…";

/* File access (open panel and alert) */
"Grant Access" = "Conceder Acesso";
"Hold ⌘ and select “%@” and “%@”, then click Grant Access." = "Mantenha ⌘ pressionado e selecione “%@” e “%@” e clique em Conceder Acesso.";
"Select “%@”, then click Grant Access." = "Selecione “%@” e clique em Conceder Acesso.";
"Tacet needs both folders" = "O Tacet precisa das duas pastas";

/* App list */
"Hide in Tacet" = "Ocultar no Tacet";
"Apps turned on here hide behind Tacet’s arrow." = "Os apps ativados aqui ficam ocultos atrás da seta do Tacet.";
"Hide %@ in Tacet" = "Ocultar %@ no Tacet";
"No apps yet." = "Nenhum app ainda.";
"Keep Always Hidden" = "Manter Sempre Oculto";
"More" = "Mais";
"Always Hidden" = "Sempre Ocultos";
"Hold ⌥ and click %@ to see these items." = "Segure ⌥ e clique em %@ para ver estes itens.";
"Move Back" = "Voltar para a Lista";
"Turned Off in System Settings" = "Desativados nos Ajustes do Sistema";
"Off" = "Desativado";
"Hidden by macOS, not by Tacet: « doesn’t show them. Turn them on in System Settings to use them." = "Ocultos pelo macOS, não pelo Tacet: a « não os mostra. Ative-os nos Ajustes do Sistema para usá-los.";
"Open Menu Bar Settings…" = "Abrir Ajustes da Barra de Menus…";
"Tacet couldn’t change the menu bar switches." = "O Tacet não conseguiu alterar os ajustes da Barra de Menus.";
"Tacet couldn’t arrange the menu bar icons." = "O Tacet não conseguiu organizar os ícones da Barra de Menus.";

