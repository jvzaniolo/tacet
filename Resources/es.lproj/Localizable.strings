/* Tacet: es. Keys are the English text in the source; see README › Localization. */

/* Onboarding */
"Welcome to Tacet" = "Te damos la bienvenida a Tacet";
"Tacet uses the macOS switches" = "Tacet usa los ajustes de macOS";
"It hides apps with the “Allow in the Menu Bar” switches in System Settings › Menu Bar. macOS does the hiding, so Notification Center, Focus and the camera and microphone indicators keep working." = "Oculta apps con el ajuste “Permitir en la barra de menús” de Ajustes del Sistema › Barra de menús. Es macOS quien las oculta, así que el centro de notificaciones, los modos de concentración y los indicadores de cámara y micrófono siguen funcionando.";
"Hidden apps show as off in System Settings" = "Las apps ocultas aparecen desactivadas en Ajustes del Sistema";
"Click « in the menu bar to bring them back. If anything ever goes wrong, turn them back on in System Settings › Menu Bar." = "Haz clic en « en la barra de menús para recuperarlas. Si algo falla, vuelve a activarlas en Ajustes del Sistema › Barra de menús.";
"Quitting turns them back on" = "Al salir, vuelven a activarse";
"Quitting Tacet turns every app it hid back on. Quit Tacet before you delete it." = "Al salir, Tacet vuelve a activar todas las apps que ocultó. Sal de Tacet antes de eliminarlo.";
"Tacet arranges the icons" = "Tacet ordena los iconos";
"Hidden apps sit left of the arrow, always-hidden ones further left. Tacet keeps that order, so there’s nothing to drag." = "Las apps ocultas quedan a la izquierda de la flecha, y las siempre ocultas aún más a la izquierda. Tacet mantiene ese orden, así que no hay nada que arrastrar.";
"This version of macOS doesn’t offer the switches Tacet needs." = "Esta versión de macOS no ofrece los ajustes que Tacet necesita.";
"Tacet can change the switches." = "Tacet puede cambiar los ajustes.";
"Allow Tacet to change the switches" = "Permite que Tacet cambie los ajustes";
"macOS keeps the switches and the order of the menu bar icons in two settings folders. In the next window, hold ⌘ and select “%@” and “%@” (the only ones you can click), then click Grant Access. Tacet changes only the “Allow in the Menu Bar” switches and the order of the icons." = "macOS guarda los ajustes y el orden de los iconos de la barra de menús en dos carpetas de ajustes. En la siguiente ventana, mantén pulsada ⌘ y selecciona “%@” y “%@” (las únicas en las que puedes hacer clic) y haz clic en Conceder acceso. Tacet solo cambia los ajustes de “Permitir en la barra de menús” y el orden de los iconos.";
"Tacet lost access to the switches. Apps it hid may still be off: grant access again and Tacet turns them back on when you quit it, or turn them on yourself in System Settings › Menu Bar." = "Tacet perdió el acceso a los ajustes. Puede que las apps que ocultó sigan desactivadas: vuelve a concederle acceso y Tacet las activará al salir, o actívalas tú en Ajustes del Sistema › Barra de menús.";
"Choose Apps to Hide…" = "Elegir apps para ocultar…";
"Grant Access…" = "Conceder acceso…";

/* File access (open panel and alert) */
"Grant Access" = "Conceder acceso";
"Hold ⌘ and select “%@” and “%@”, then click Grant Access." = "Mantén pulsada ⌘ y selecciona “%@” y “%@” y haz clic en Conceder acceso.";
"Select “%@”, then click Grant Access." = "Selecciona “%@” y haz clic en Conceder acceso.";
"Tacet needs both folders" = "Tacet necesita las dos carpetas";

/* App list */
"Hide in Tacet" = "Ocultar en Tacet";
"Apps turned on here hide behind Tacet’s arrow." = "Las apps activadas aquí se ocultan tras la flecha de Tacet.";
"Hide %@ in Tacet" = "Ocultar %@ en Tacet";
"No apps yet." = "Aún no hay apps.";
"Keep Always Hidden" = "Mantener siempre oculto";
"More" = "Más";
"Always Hidden" = "Siempre ocultos";
"Hold ⌥ and click %@ to see these items." = "Mantén ⌥ y haz clic en %@ para ver estos ítems.";
"Move Back" = "Volver a la lista";
"Turned Off in System Settings" = "Desactivadas en Ajustes del Sistema";
"Off" = "Desactivada";
"Hidden by macOS, not by Tacet: « doesn’t show them. Turn them on in System Settings to use them." = "Ocultas por macOS, no por Tacet: « no las muestra. Actívalas en Ajustes del Sistema para usarlas.";
"Open Menu Bar Settings…" = "Abrir ajustes de la barra de menús…";
"Tacet couldn’t change the menu bar switches." = "Tacet no ha podido cambiar los ajustes de la barra de menús.";
"Tacet couldn’t arrange the menu bar icons." = "Tacet no pudo ordenar los iconos de la barra de menús.";

/* Open at Login and the keyboard shortcut (macOS's own terms) */
"Open at Login" = "Abrir al iniciar sesión";
"Tacet is turned off in System Settings › General › Login Items & Extensions. Turn it on there to open Tacet at login." = "Tacet está desactivado en Ajustes del Sistema › General › Ítems de inicio y extensiones. Actívalo allí para abrir Tacet al iniciar sesión.";
"Open Login Items & Extensions…" = "Abrir ítems de inicio y extensiones…";
"Keyboard Shortcut" = "Atajo de teclado";
"Show or hide your hidden apps." = "Muestra u oculta las apps ocultas.";
"%@ is already used by another app." = "Otra app ya usa %@.";
"Type Shortcut" = "Pulsa el atajo";
"Record Shortcut" = "Grabar atajo";
"Clear Shortcut" = "Borrar atajo";
"Click to record a new shortcut." = "Haz clic para grabar un atajo nuevo.";
"Show All Items" = "Mostrar todos los ítems";
"Toggle Always Hidden" = "Alternar siempre ocultas";
"Use ⌘, ⌥ or ⌃ in the shortcut." = "Usa ⌘, ⌥ o ⌃ en el atajo.";
"%@ is used by macOS. Choose a different shortcut." = "macOS usa %@. Elige otro atajo.";
"%@ is already used by another app. Choose a different shortcut." = "Otra app ya usa %@. Elige otro atajo.";
"Space" = "Espacio";


/* Status item and menu (arrow labels are Apple's own for its overflow arrow) */
"Show Hidden Menu Bar Items" = "Mostrar los ítems ocultos de la barra de menús";
"Hide Menu Bar Items" = "Ocultar los ítems de la barra de menús";
"Show Hidden Items" = "Mostrar ítems ocultos";
"Hide Items" = "Ocultar ítems";
"Settings…" = "Ajustes…";
"Quit Tacet" = "Salir de Tacet";

